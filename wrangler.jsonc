{
  // Cloudflare Workers configuration: static assets (the Vue SPA) + one
  // dynamic endpoint (POST /api/contact) handled by src/index.js.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vue-portfolio",
  "compatibility_date": "2026-09-25",

  // Worker entry point. Bundled automatically by `wrangler deploy`.
  "main": "src/index.js",

  // Non-secret plain-text variables.
  // For a quick test keep `onboarding@resend.dev`; for real sending, verify
  // your own domain in Resend and use e.g. "portfolio@yourdomain.com".
  "vars": {
    "CONTACT_FROM": "onboarding@resend.dev"
  },

  // Secrets that must exist on the deployed Worker.
  // Declaring them enables validation: `wrangler dev` warns locally when a
  // secret is missing from .dev.vars, and `wrangler types` can generate env types.
  // Set them once with:  npx wrangler secret put RESEND_API_KEY
  "secrets": {
    "required": ["RESEND_API_KEY", "CONTACT_TO"]
  },

  "assets": {
    // Vite's default build output directory.
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA routing: unknown paths fall back to index.html with a 200 response,
    // so Vue Router's history mode works on deep links and refreshes.
    "not_found_handling": "single-page-application",
    // Only /api/* goes through the Worker; everything else is served as static
    // assets directly from the edge (fastest possible path).
    "run_worker_first": ["/api/*"]
  }
}

